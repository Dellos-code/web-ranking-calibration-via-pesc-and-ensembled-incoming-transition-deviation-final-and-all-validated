\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Πλήρεις διαδικασίες έναντι των στατικών ρυθμίσεων του [NG13] υπό και τις πέντε αλήθειες. Κελιά: μέσο $\tau $ του Kendall ανά στιγμιότυπο· σε παρένθεση, η διαφορά έναντι του [NG13] $(0.118,0.85)$ με μέσο όρο ανά γράφο (κάθε γράφος με ίσο βάρος). \emph  {Δύο στάδια}: $r$ από τον κλειδωμένο κανόνα του Σταδίου~1 και $\alpha =0.81$, αμφότερα προσαρμοσμένα σε γράφους βαθμονόμησης υπό NCD και εφαρμοσμένα αμετάβλητα υπό κάθε αλήθεια. Οι αλήθειες POP και Q υπάρχουν μόνο για τη στατική γεννήτρια.}}{23}{table.caption.25}\protected@file@percent }
\newlabel{tab:pipe}{{12}{23}{Πλήρεις διαδικασίες έναντι των στατικών ρυθμίσεων του [NG13] υπό και τις πέντε αλήθειες. Κελιά: μέσο $\tau $ του Kendall ανά στιγμιότυπο· σε παρένθεση, η διαφορά έναντι του [NG13] $(0.118,0.85)$ με μέσο όρο ανά γράφο (κάθε γράφος με ίσο βάρος). \emph {Δύο στάδια}: $r$ από τον κλειδωμένο κανόνα του Σταδίου~1 και $\alpha =0.81$, αμφότερα προσαρμοσμένα σε γράφους βαθμονόμησης υπό NCD και εφαρμοσμένα αμετάβλητα υπό κάθε αλήθεια. Οι αλήθειες POP και Q υπάρχουν μόνο για τη στατική γεννήτρια}{table.caption.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Πλήθος επαναλήψεων της μεθόδου δυνάμεων πριν και μετά την έκπτωση θορύβου (κριτήριο τερματισμού $\|\pi ^{(k+1)}-\pi ^{(k)}\|_1<\varepsilon =10^{-6}$, αρχή $v$). Η στήλη του φράγματος είναι η εκ των προτέρων εκτίμηση από το $|\lambda _2(P)|\le \alpha $· οι μετρημένες στήλες είναι μέσοι όροι σε όλα τα διαταραγμένα στιγμιότυπα του συνόλου.}}{23}{table.caption.26}\protected@file@percent }
\newlabel{tab:conv}{{13}{23}{Πλήθος επαναλήψεων της μεθόδου δυνάμεων πριν και μετά την έκπτωση θορύβου (κριτήριο τερματισμού $\|\pi ^{(k+1)}-\pi ^{(k)}\|_1<\varepsilon =10^{-6}$, αρχή $v$). Η στήλη του φράγματος είναι η εκ των προτέρων εκτίμηση από το $|\lambda _2(P)|\le \alpha $· οι μετρημένες στήλες είναι μέσοι όροι σε όλα τα διαταραγμένα στιγμιότυπα του συνόλου}{table.caption.26}{}}
