\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Βέλτιστη απόσβεση υπό τις πέντε αλήθειες (σύνολο βαθμονόμησης). Δικό $\alpha $: η απόσβεση που ορίζει την αλήθεια ($^{a}$TotalRank: μέση τιμή της εκ των προτέρων Beta(1,1)· $^{b}$το POP είναι το PageRank του αναμενόμενου περιπάτου στο $0.85$). $\alpha ^*$ (A1.0): μέσο μαντείο στους αδιατάρακτους γράφους. Μέσο $\alpha ^*$: μέση τιμή στα διαταραγμένα στιγμιότυπα· έκπτωση: η διαφορά τους. Σταθ.\ $\alpha $: η καλύτερη σταθερά στο σύνολο βαθμονόμησης. Εντός/μεταξύ: συσχέτιση του $h$ με το $\alpha ^*$ εντός γράφων και μεταξύ των μέσων τιμών των γράφων.}}{20}{table.caption.20}\protected@file@percent }
\newlabel{tab:anchor}{{9}{20}{Βέλτιστη απόσβεση υπό τις πέντε αλήθειες (σύνολο βαθμονόμησης). Δικό $\alpha $: η απόσβεση που ορίζει την αλήθεια ($^{a}$TotalRank: μέση τιμή της εκ των προτέρων Beta(1,1)· $^{b}$το POP είναι το PageRank του αναμενόμενου περιπάτου στο $0.85$). $\alpha ^*$ (A1.0): μέσο μαντείο στους αδιατάρακτους γράφους. Μέσο $\alpha ^*$: μέση τιμή στα διαταραγμένα στιγμιότυπα· έκπτωση: η διαφορά τους. Σταθ.\ $\alpha $: η καλύτερη σταθερά στο σύνολο βαθμονόμησης. Εντός/μεταξύ: συσχέτιση του $h$ με το $\alpha ^*$ εντός γράφων και μεταξύ των μέσων τιμών των γράφων}{table.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Έλεγχος δόσης--απόκρισης της αγκύρωσης: βέλτιστη απόσβεση $\alpha ^*$ έναντι αναφορών Random-$\alpha $ NCDawareRank $\mathbb  {E}[\pi (A)]$ με $A\sim \mathrm  {Beta}(a,b)$, σε 16 γράφους βαθμονόμησης (μόνο διαταραγμένα στιγμιότυπα, $r$ = κανόνας Σταδίου~1, πλέγμα $0.05$--$0.99$). Η Beta(1,1) είναι το TotalRank.}}{20}{table.caption.21}\protected@file@percent }
