\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Ποσοστό της διασποράς του βέλτιστου λόγου $r^*$ που εξηγείται ($R^2$) στο σύνολο βαθμονόμησης. Η ταυτότητα του γράφου, το επίπεδο διαταραχής και ο προσθετικός τους συνδυασμός είναι μερίδια ANOVA εντός δείγματος. Οι στήλες με αστερίσκο είναι εκτός δείγματος (ομαδοποιημένη 8-πλή CV ανά γράφο): ενισχυμένα δέντρα στις κρυφές παραμέτρους της γεννήτριας μαζί με το επίπεδο διαταραχής· παλινδρόμηση ridge σε όλα τα παρατηρήσιμα καθολικά στατιστικά· και ο αποκομμένος γραμμικός κανόνας στο $\bar  P^{(M)}_{\mathrm  {esc}}$. Αρνητικές τιμές σημαίνουν χειρότερη πρόβλεψη από τη μέση τιμή.}}{13}{table.caption.11}\protected@file@percent }
\newlabel{tab:stage1dec}{{4}{13}{Ποσοστό της διασποράς του βέλτιστου λόγου $r^*$ που εξηγείται ($R^2$) στο σύνολο βαθμονόμησης. Η ταυτότητα του γράφου, το επίπεδο διαταραχής και ο προσθετικός τους συνδυασμός είναι μερίδια ANOVA εντός δείγματος. Οι στήλες με αστερίσκο είναι εκτός δείγματος (ομαδοποιημένη 8-πλή CV ανά γράφο): ενισχυμένα δέντρα στις κρυφές παραμέτρους της γεννήτριας μαζί με το επίπεδο διαταραχής· παλινδρόμηση ridge σε όλα τα παρατηρήσιμα καθολικά στατιστικά· και ο αποκομμένος γραμμικός κανόνας στο $\bar P^{(M)}_{\mathrm {esc}}$. Αρνητικές τιμές σημαίνουν χειρότερη πρόβλεψη από τη μέση τιμή}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Βέλτιστος λόγος του Σταδίου~1 έναντι του $\bar  P^{(M)}_{\mathrm  {esc}}$ υπό τις τέσσερις αλήθειες του Σταδίου~1 (σύνολο βαθμονόμησης). Υπό την SELF, το πρωτόκολλο του~\cite  {ng13}, το μαντείο ωθείται στο άνω όριο του πλέγματος.}}{13}{figure.caption.12}\protected@file@percent }
\newlabel{fig:s1truth}{{2}{13}{Βέλτιστος λόγος του Σταδίου~1 έναντι του $\Pbar $ υπό τις τέσσερις αλήθειες του Σταδίου~1 (σύνολο βαθμονόμησης). Υπό την SELF, το πρωτόκολλο του~\cite {ng13}, το μαντείο ωθείται στο άνω όριο του πλέγματος}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Διαγνωστικά του Σταδίου~1. \textbf  {(α)} Καμπύλες $\tau (r)$ για έναν γράφο βαθμονόμησης υπό αυξανόμενη απώλεια συνδέσμων· οι κουκκίδες σημειώνουν το $r^*$, το οποίο απομακρύνεται από την κανονική τιμή καθώς χάνονται σύνδεσμοι. \textbf  {(β)} Μερίδιο της διασποράς του $r^*$ που εξηγεί κάθε πηγή. \textbf  {(γ)} Μέσο $r^*$ ανά γράφο υπό την POP έναντι του λανθάνοντος ICC, χρωματισμένο κατά τη διασπορά της λανθάνουσας ποιότητας. \textbf  {(δ)} Μερίδιο του χάσματος κανονικού--μαντείου που καλύπτεται εκτός δείγματος από τον κανόνα και από την καλύτερη σταθερά.}}{14}{figure.caption.13}\protected@file@percent }
\newlabel{fig:s1diag}{{3}{14}{Διαγνωστικά του Σταδίου~1. \textbf {(α)} Καμπύλες $\tau (r)$ για έναν γράφο βαθμονόμησης υπό αυξανόμενη απώλεια συνδέσμων· οι κουκκίδες σημειώνουν το $r^*$, το οποίο απομακρύνεται από την κανονική τιμή καθώς χάνονται σύνδεσμοι. \textbf {(β)} Μερίδιο της διασποράς του $r^*$ που εξηγεί κάθε πηγή. \textbf {(γ)} Μέσο $r^*$ ανά γράφο υπό την POP έναντι του λανθάνοντος ICC, χρωματισμένο κατά τη διασπορά της λανθάνουσας ποιότητας. \textbf {(δ)} Μερίδιο του χάσματος κανονικού--μαντείου που καλύπτεται εκτός δείγματος από τον κανόνα και από την καλύτερη σταθερά}{figure.caption.13}{}}
